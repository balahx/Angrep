rules_version = '2';
// Cada cuenta lee y escribe solo lo suyo (users/{su uid}/records/*). Todo lo que no está permitido aquí queda prohibido.
// Para escribir hay que tener el correo verificado (frena cuentas falsas); el dueño de la app queda exento por si su cuenta se creó a mano.
// Cambia el correo del dueño si usas otro.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && (request.auth.token.email_verified == true || request.auth.token.email == 'felipe.gonzalezg01@gmail.com');
    }
    // users/{uid}/records/{tipo__id}: un documento por registro
    match /users/{uid}/records/{key} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['t', 'd', 'u', 'del', 'at'])
        && request.resource.data.keys().hasAll(['t', 'd', 'u', 'at'])
        && request.resource.data.t in ['profile', 'weight', 'steps', 'measure', 'goal', 'food', 'meal', 'nutriday', 'exercise', 'plan', 'session']
        && request.resource.data.d is string && request.resource.data.d.size() < 200000
        && request.resource.data.u is int && request.resource.data.u <= request.time.toMillis() + 600000
        && request.resource.data.at == request.time
        && (!('del' in request.resource.data) || request.resource.data.del is bool)
        && key.size() <= 160;
      allow delete: if false;
    }
  }
}
