rules_version = '2';
// Acceso por aprobación: cualquiera puede crear su cuenta y pedir acceso, pero solo las cuentas aprobadas por el administrador
// (documento members/{uid}) pueden leer y escribir sus datos (users/{su uid}/records/*). Todo lo no permitido aquí queda prohibido.
// El administrador es quien tiene el correo de abajo (cámbialo si usas otro). Su cuenta no necesita estar en members.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'felipe.gonzalezg01@gmail.com'; }
    function isMember(uid) { return exists(/databases/$(database)/documents/members/$(uid)); }
    // Plan del entrenador: lo ve el administrador y las cuentas aprobadas a las que el administrador les activó «plan» en members/{uid}.
    function canPlan() { return signedIn() && (isAdmin() || (exists(/databases/$(database)/documents/members/$(request.auth.uid)) && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('plan', false) == true)); }
    function canUse(uid) { return signedIn() && request.auth.uid == uid && (isAdmin() || isMember(uid)); }

    // users/{uid}/records/{tipo__id}: un documento por registro
    match /users/{uid}/records/{key} {
      allow read: if canUse(uid);
      allow create, update: if canUse(uid)
        && request.resource.data.keys().hasOnly(['t', 'd', 'u', 'del', 'at'])
        && request.resource.data.keys().hasAll(['t', 'd', 'u', 'at'])
        && request.resource.data.t in ['profile', 'weight', 'steps', 'measure', 'goal', 'food', 'meal', 'nutriday', 'exercise', 'plan', 'session']
        && request.resource.data.d is string && request.resource.data.d.size() < 200000
        && request.resource.data.u is int && request.resource.data.u <= request.time.toMillis() + 600000
        && request.resource.data.at == request.time
        && (!('del' in request.resource.data) || request.resource.data.del is bool)
        && key.size() <= 160;
      allow delete: if false;
    }

    // Plan del entrenador: config/plan (versión, chico) y plans/data (el plan comprimido). Solo el administrador escribe.
    match /config/plan {
      allow get: if canPlan();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['ver', 'name', 'weeks', 'at'])
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.weeks is int
        && request.resource.data.at == request.time;
      allow delete: if isAdmin();
    }
    match /plans/data {
      allow get: if canPlan();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['z', 'ver'])
        && request.resource.data.z is string && request.resource.data.z.size() < 900000
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 40;
      allow delete: if isAdmin();
    }

    // Cuentas aprobadas. Solo las crea el administrador; cada persona puede ver la suya.
    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'approvedAt', 'plan'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.approvedAt == request.time
        && (!('plan' in request.resource.data) || request.resource.data.plan is bool);
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'approvedAt', 'plan'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && (request.resource.data.approvedAt == request.time || request.resource.data.approvedAt == resource.data.approvedAt)
        && (!('plan' in request.resource.data) || request.resource.data.plan is bool);
      allow delete: if isAdmin();
    }

    // Solicitudes de acceso: cada persona crea la suya (con su correo y la hora del servidor). El administrador decide a quién aprobar.
    match /requests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'status', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      // El administrador solo puede marcarla como rechazada (aprobar = crear el miembro y borrar la solicitud)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'rejected';
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
  }
}
